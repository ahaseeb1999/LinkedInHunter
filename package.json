{
  "name": "linkedin-hunter",
  "version": "1.1.0",
  "description": "Professional LinkedIn Job & Opportunity Hunter",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "obfuscate": "node scripts/obfuscate.js",
    "package": "npm run build && node scripts/inject-secret.js && npm run obfuscate && electron-builder --win",
    "package:portable": "npm run build && node scripts/inject-secret.js && npm run obfuscate && electron-builder --win portable",
    "release": "npm run build && node scripts/inject-secret.js && npm run obfuscate && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.2.1",
    "exceljs": "^4.4.0",
    "node-cron": "^3.0.3",
    "node-sqlite3-wasm": "^0.8.12",
    "playwright": "^1.44.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.linkedinhunter.app",
    "productName": "LinkedIn Hunter",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      { "from": "pw-browsers", "to": "pw-browsers" }
    ],
    "publish": {
      "provider": "github",
      "owner": "ahaseeb1999",
      "repo": "LinkedInHunter",
      "releaseType": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "LinkedInHunter-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LinkedIn Hunter"
    }
  }
}
