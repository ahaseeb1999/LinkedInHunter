# LinkedIn Hunter — .gitignore

# ── Dependencies & build output ──────────────────────────────
node_modules/
dist/
dist-exe/

# ── Databases & local state (NEVER commit) ───────────────────
*.db
*.db-shm
*.db-wal
*.db.lock/
*.db.lock
data/
hunt-state.json

# ── Local debug dumps (HTML/screenshots from scraper) ────────
debug/
**/debug/
*.png.tmp
*.html.tmp

# ── Secrets / env files ──────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Cloudflare Wrangler local state (contains local D1 copy) ─
.wrangler/
**/.wrangler/

# ── Playwright browsers ──────────────────────────────────────
.cache/
playwright-report/
# Bundled-browser folder: CI fills it with Chromium at build time and
# electron-builder ships it via extraResources. Keep the folder (.gitkeep)
# but never commit the heavy binaries.
pw-browsers/*
!pw-browsers/.gitkeep

# ── OS / editor noise ────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.tmp
.vscode/
.idea/

# ── Backup folder is fine to commit (intentional snapshots) ─
# !backups/

# ── Private docs kept on disk but not in the public repo ─────
implementation.md
RELEASING.md
admin-panel/README.md
license-server/README.md
backups/post-feature-v1-2026-05-24/README.md

# ── Local-only working folders — not part of the published app ──
/license-server/
/admin-panel/
