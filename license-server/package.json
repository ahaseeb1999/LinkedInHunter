{
  "name": "linkedin-hunter-license-server",
  "version": "0.1.0",
  "description": "License + admin API for LinkedIn Hunter (runs on Cloudflare Workers)",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:schema": "wrangler d1 execute linkedin-hunter-db --remote --file=schema.sql",
    "db:migrate:001": "wrangler d1 execute linkedin-hunter-db --remote --file=migrations/001-add-key-encrypted.sql",
    "db:console": "wrangler d1 execute linkedin-hunter-db --remote --command=\"SELECT name FROM sqlite_master\"",
    "secrets:set": "node scripts/set-secrets.js",
    "admin:create": "node scripts/create-admin.js",
    "test": "node test/run.js"
  },
  "dependencies": {
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.95.0"
  }
}
